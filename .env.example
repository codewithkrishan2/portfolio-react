# EmailJS — powers the contact form.
#
# These are client-side values by design: the "public key" is intended to be
# exposed in the browser. They are read from the environment so they can be
# rotated without a code change. If unset, components/Contact.tsx falls back to
# the identifiers the previous version of the site already shipped, so an
# unconfigured build still works.
#
# Dashboard: https://dashboard.emailjs.com/admin
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_c1zbveh
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_r3qqy8d
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=AhQ7M1kBPQAgRsv_Z
